# =============================================================================
# ICS example configuration for production
#
# Copy to `.env` and fill in. Docker Compose reads .env on its own
# (`${VAR}` interpolation in compose.yaml and variables in env_file).
#
# NOTE: never commit a filled-in .env. It is in .gitignore.
# =============================================================================


# ---------- Secrets (generate unique values for every environment) ----------

# Signing key for every token (invitations, magic links, HTML grants, session
# cookies, audit IP hashes). Generate with `openssl rand -hex 32`.
# The app refuses to start with the default 'dev-secret-change-me' when
# ICS_DEBUG=0 (production).
ICS_SECRET_KEY=

# Password of the `ics` Postgres user. Generate with `openssl rand -base64 24`.
ICS_PG_PASSWORD=

# Postgres connection string. In the compose deployment it is built from
# `ICS_PG_PASSWORD` (see compose.yaml); leave it empty when Postgres runs on
# the host behind host.docker.internal. Override only when:
#  - Postgres runs on another host than `host.docker.internal`,
#  - you need another port or DSN parameters (sslmode, pooler, ...),
#  - you use a managed service (RDS, Supabase, Neon).
# The password in the URL MUST match ICS_PG_PASSWORD, the backend only reads the URL.
ICS_DATABASE_URL=

# Redis connection string. Empty means the compose default
# (redis://redis:6379/0). Override for an external Redis (Upstash, ElastiCache).
ICS_REDIS_URL=

# First admin: when both are set and the database has no admin yet, the
# container creates this account on start. Use a long password.
ICS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
ICS_BOOTSTRAP_ADMIN_PASSWORD=


# ---------- Hosts and CORS ----------

# Main address users see. The scheme (http/https) must match the reverse
# proxy setup (TLS in production).
ICS_BASE_URL=https://ics.example.com

# Isolated host that serves uploaded HTML bundles on a separate origin.
# Must differ from BASE_URL, otherwise cookie and session isolation is lost.
ICS_HTML_VIEWER_BASE=https://html.ics.example.com

# Allowed CORS origins, comma separated. The frontend lives under BASE_URL,
# so that is the minimum. It is also the list of origins the cross-site
# request check trusts for cookie-authenticated writes.
ICS_CORS_ORIGINS=https://ics.example.com

# E-mail domains of the organisation: who may sign in with Google SSO.
# Comma separated. `org_sso` links open only for signed-in users from this list.
ICS_ALLOWED_DOMAINS=example.com

# Container image of the ics-sync CLI used in the GitLab CI snippet of a binding.
ICS_SYNC_IMAGE=ghcr.io/inprojectspl/ics-sync:1


# ---------- Mode ----------

# 0 in production. 1 relaxes security headers and the secret key check
# (debugging only).
ICS_DEBUG=0
ICS_LOG_LEVEL=info

# Allow self-registration? Off by default: an admin invites people through
# `/api/auth/invite`.
ICS_ALLOW_SELF_REGISTER=false

# Dev-stub SSO, the "sign in as anyone" shortcut. Keep it OFF in production;
# the app refuses to start with it enabled when ICS_DEBUG=0.
ICS_DEV_STUB_SSO=false


# ---------- Google OIDC (optional, recommended) ----------
#
# Step by step:
# 1. Open https://console.cloud.google.com/apis/credentials
# 2. "Create credentials > OAuth 2.0 Client ID"
# 3. Type: Web application
# 4. Authorized redirect URIs: {ICS_BASE_URL}/api/auth/google/callback
# 5. Copy the Client ID and Client secret here.

ICS_GOOGLE_OIDC_CLIENT_ID=
ICS_GOOGLE_OIDC_CLIENT_SECRET=


# ---------- File storage ----------

# Filesystem (default, a file in a Docker volume):
ICS_STORAGE_URL=fs:///data/storage

# Cloudflare R2 (recommended for larger installs, no egress fees):
# ICS_STORAGE_URL=s3://my-bucket
# ICS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# ICS_S3_ACCESS_KEY_ID=
# ICS_S3_SECRET_ACCESS_KEY=
# ICS_S3_REGION=auto

# AWS S3:
# ICS_STORAGE_URL=s3://my-bucket
# ICS_S3_ENDPOINT_URL=https://s3.eu-central-1.amazonaws.com
# ICS_S3_ACCESS_KEY_ID=
# ICS_S3_SECRET_ACCESS_KEY=
# ICS_S3_REGION=eu-central-1


# ---------- Limits ----------

# Maximum size of a single document in bytes. Default 100 MiB.
ICS_MAX_ASSET_BYTES=104857600

# Maximum number of files in one upload or version: an HTML bundle, a Markdown
# collection, or the archive a GitLab binding sync sends.
ICS_MAX_FILES_PER_BUNDLE=500

# Failed sign-ins (per hour) before an account is locked for a while.
ICS_LOCKOUT_THRESHOLD=10
ICS_LOCKOUT_MINUTES=15


# ---------- HTML bundle security ----------

# Permissive by default: trusted CDNs are informational, warning patterns
# (inline event handlers, document.write) are downgraded to info, and only
# truly dangerous patterns block (eval, document.cookie, javascript:).
# `strict` keeps the original policy where every external script blocks.
ICS_SECURITY_POLICY=permissive

# CDN hosts treated as trusted. Admins can extend the list at runtime in
# /admin/cdn; this is only the BASE list.
ICS_TRUSTED_CDN_HOSTS=cdn.jsdelivr.net,cdnjs.cloudflare.com,unpkg.com,esm.sh,cdn.skypack.dev,fonts.googleapis.com,fonts.gstatic.com,ajax.googleapis.com,cdn.tailwindcss.com,d3js.org,cdn.plot.ly


# ---------- SMTP (optional, recommended) ----------
#
# When `ICS_SMTP_HOST` is set, the app tries to send each e-mail over SMTP
# right after storing it in the database (`email_outbox`). Without it e-mails
# stay in the database only and an admin has to pull them out by hand.
#
# Development uses MailPit (compose.dev.yaml starts it); in production plug in
# your relay (local Postfix, AWS SES, Mailgun, ...).

ICS_SMTP_HOST=
ICS_SMTP_PORT=587
ICS_SMTP_FROM=ICS <no-reply@example.com>
ICS_SMTP_USER=
ICS_SMTP_PASSWORD=
ICS_SMTP_USE_TLS=true


# ---------- Images (compose.prod.yaml) ----------

# Registry path of the backend and frontend images, e.g. ghcr.io/<owner>/ics,
# and the tag to run (default latest).
ICS_IMAGE_REGISTRY=
IMAGE_TAG=latest

# ---------- Edge / ingress ----------
#
# TLS and routing belong to an external reverse proxy; ICS configures no
# certificates or hosts in compose. Example: docs/deploy/nginx.example.conf.
# Name of the existing docker network the proxy is attached to:
ICS_EDGE_NETWORK=edge

# ---------- Notifications (ADR-0023) ----------
# Web Push needs a VAPID key pair: `docker compose exec backend python -m app.cli vapid-keygen`.
# Without the private key browser notifications are off (in-app, e-mail and Chat still work).
ICS_VAPID_PRIVATE_KEY=
ICS_VAPID_SUBJECT=mailto:ops@example.com
# Inbox size per user and retention in Redis.
ICS_NOTIFICATIONS_INBOX_MAX=150
ICS_NOTIFICATIONS_RETENTION_DAYS=30
# E-mail batching window and the daily digest hour.
ICS_NOTIFICATIONS_EMAIL_BATCH_SECONDS=600
ICS_NOTIFICATIONS_DIGEST_HOUR=8
ICS_NOTIFICATIONS_TIMEZONE=Europe/Warsaw
